        String s = "got    place    at    zoho";

        int count=0;

        for(int i=0;i<s.length();i++){

            if(i==0 && s.charAt(i)!=' '){

                count++;
            }
            else{

               if(s.charAt(i)!=' '&&s.charAt(i-1)==' '){

                   count++;
               }
            }


        }
        System.out.println(count);


    }
